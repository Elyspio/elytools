	"devDependencies": {
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@elyspio/vite-eslint-config": "^8.0.0-rc.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/semver": "^7.8.0",
		"electron": "^45.3.0",
		"electron-builder": "^26.18.1",
		"electron-vite": "^6.0.0",
