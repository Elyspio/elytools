{
	"name": "elytools",
	"version": "2.3.0",
	"description": "An Electron application with React and TypeScript",
	"author": "jona.guich69@gmail.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/Elyspio/elytools.git"
	},
	"main": "./out/main/index.js",
	"scripts": {
		"clean": "tsx ./scripts/clean/clean-release.ts",
		"clean:bundle": "tsx ./scripts/clean/clean-bundle.ts",
		"postinstall": "install-electron",
		"check": "vp check --fix",
		"test": "vp test",
		"typecheck": "tsc --watch --noEmit",
		"start": "electron-vite preview",
		"dev": "electron-vite -c config/electron.vite.config.ts dev -w",
		"prebuild": "rimraf out dist",
		"build": "electron-vite -c config/electron.vite.config.ts build",
		"package": "node scripts/release/release.ts package",
		"package:linux": "node scripts/release/release.ts package-linux",
		"release": "node scripts/release/release.ts",
		"release:dev": "node scripts/release/release.ts dev"
	},
	"dependencies": {
		"@chrissantamaria/electron-devtools-installer": "4.0.0-fork.1",
		"@ctrl/qbittorrent": "^10.1.1",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@elyspio/llm-usage-collector": "^0.3.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@mui/icons-material": "^9.5.0",
		"@mui/material": "^9.5.0",
		"@mui/x-data-grid": "^9.17.0",
		"@nestjs/common": "^12.4.2",
		"@reduxjs/toolkit": "^2.14.0",
		"@tsed/logger": "^8.0.7",
		"@types/ssh2": "^1.15.6",
		"@vitejs/plugin-react": "^6.3.0",
		"builder-util-runtime": "9.7.1",
		"class-transformer": "^0.5.1",
		"class-validator": "0.15.1",
		"dayjs": "^1.11.23",
		"electron-updater": "^6.8.12",
		"fast-xml-parser": "^5.12.0",
		"inversify": "^8.3.0",
		"nest-winston": "^2.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-redux": "^9.3.1",
		"react-router": "^8.5.1",
		"react-syntax-highlighter": "^16.1.2",
		"react-toastify": "^11.2.0",
		"redux": "5.0.1",
		"reflect-metadata": "^0.2.2",
